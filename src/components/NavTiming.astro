---
import Container from "./Container.astro";

const rows = [
    { id: "dns", label: "DNS lookup" },
    { id: "tcp", label: "TCP + TLS" },
    { id: "ttfb", label: "TTFB" },
    { id: "response", label: "Response" },
    { id: "dom", label: "DOM parse" },
    { id: "load", label: "Load event" },
    { id: "fcp", label: "FCP" },
    { id: "total", label: "Total" },
];
---

<div id="timing">
    <Container>
        <div class="mx-auto max-w-lg">
            <div
                class="overflow-hidden rounded-2xl border border-gray-100 bg-gray-900 font-mono text-sm shadow-2xl shadow-gray-600/10 dark:border-gray-700 dark:shadow-none"
            >
                <div class="flex items-center gap-2 border-b border-white/10 px-5 py-3">
                    <span aria-hidden="true" class="h-3 w-3 rounded-full bg-red-400"></span>
                    <span aria-hidden="true" class="h-3 w-3 rounded-full bg-yellow-400"></span>
                    <span aria-hidden="true" class="h-3 w-3 rounded-full bg-green-400"></span>
                    <span class="ml-2 text-gray-400">── Navigation Timing ──</span>
                </div>
                <div class="px-5 py-4 text-gray-200">
                    {
                        rows.map((row) => (
                            <div class="flex justify-between py-0.5">
                                <span>{row.label}</span>
                                <span class="text-secondary" data-timing={row.id}>
                                    …
                                </span>
                            </div>
                        ))
                    }
                    <div class="mt-3 text-gray-400">
                        document: <span data-timing="size">…</span>
                    </div>
                </div>
            </div>
            <p class="mt-4 text-center text-xs text-gray-400 dark:text-gray-500">
                How fast this page loaded for you, measured live in your browser. Fast sites are a feature.
            </p>
        </div>
    </Container>
</div>

<script>
    function ms(value: number): string {
        return `${Math.max(0, Math.round(value))}ms`;
    }

    function set(id: string, text: string) {
        const el = document.querySelector(`[data-timing="${id}"]`);
        if (el) el.textContent = text;
    }

    function report() {
        const [nav] = performance.getEntriesByType("navigation") as PerformanceNavigationTiming[];
        if (!nav) return;

        set("dns", ms(nav.domainLookupEnd - nav.domainLookupStart));
        set("tcp", ms(nav.connectEnd - nav.connectStart));
        set("ttfb", ms(nav.responseStart - nav.requestStart));
        set("response", ms(nav.responseEnd - nav.responseStart));
        set("dom", ms(nav.domInteractive - nav.responseEnd));
        set("load", ms(nav.loadEventEnd - nav.loadEventStart));
        set("total", ms(nav.loadEventEnd || nav.duration));

        const fcp = performance.getEntriesByName("first-contentful-paint")[0];
        set("fcp", fcp ? ms(fcp.startTime) : "n/a");

        const kb = nav.transferSize > 0 ? `${(nav.transferSize / 1024).toFixed(1)}kB` : "cached";
        const type = nav.type === "reload" ? " · reload" : nav.type === "back_forward" ? " · bfcache" : "";
        set("size", `${kb}${type}`);
    }

    if (document.readyState === "complete") {
        report();
    } else {
        // loadEventEnd is only populated after the load event finishes
        window.addEventListener("load", () => setTimeout(report, 0));
    }
</script>
