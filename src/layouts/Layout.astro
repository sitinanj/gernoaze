---
import AppHeader from "../components/AppHeader.astro";
import urbanistWoff2 from "@fontsource-variable/urbanist/files/urbanist-latin-wght-normal.woff2?url";

const fontFace = `
@font-face {
    font-family: "Urbanist Variable";
    font-style: normal;
    font-display: optional;
    font-weight: 100 900;
    src: url(${urbanistWoff2}) format("woff2-variations");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
`;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <meta name="description" content="We glue systems together in order to unlock new opportunities and insights." />
        <title>Gèrnoaze</title>

        <link rel="preload" href={urbanistWoff2} as="font" type="font/woff2" crossorigin />
        <style set:html={fontFace}></style>
    </head>
    <body class="bg-white dark:bg-gray-900">
        <AppHeader />
        <slot />
    </body>
</html>
<style is:global>
    html {
        font-family: "Urbanist Variable", "Urbanist Fallback", sans-serif;
        scroll-behavior: smooth;
    }

    /* Metric-matched fallback so any swap is visually imperceptible */
    @font-face {
        font-family: "Urbanist Fallback";
        src: local("Helvetica Neue"), local("Arial");
        size-adjust: 96%;
        ascent-override: 102%;
        descent-override: 26%;
        line-gap-override: 0%;
    }

    body {
        margin: 0;
    }
</style>
